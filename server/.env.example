# Server configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/chat-app
CLIENT_URL=http://localhost:5173

# Firebase Service Account Credentials
# You can set either:
# Option A: Paste the stringified JSON key contents of your service account here:


# Option B: Put the path to your serviceAccountKey.json file here (relative or absolute):
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Redis Configuration (Optional, falls back to in-memory store in dev)
REDIS_URL=redis://127.0.0.1:6379

# Email Configuration (Mailjet Port 465 SSL)
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_mailjet_api_key
EMAIL_PASS=your_mailjet_secret_key
EMAIL_FROM="Sleek Chat" <your_verified_sender_email@gmail.com>
