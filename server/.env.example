# Server configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/chat-app
CLIENT_URL=http://localhost:5173

# Firebase Service Account Credentials
# You can set either:
# Option A: Paste the stringified JSON key contents of your service account here:


# Option B: Put the path to your serviceAccountKey.json file here (relative or absolute):
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Redis Configuration (Optional, falls back to in-memory store in dev)
REDIS_URL=redis://127.0.0.1:6379

# Nodemailer SMTP Email Configuration (Optional, falls back to console logging OTP in dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="SleekChat Team" <your_email@gmail.com>
